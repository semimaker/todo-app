{
  "semantic": {
    "primary": { "value": "#2563EB", "tailwind": "blue-600",   "cssVar": "--color-accent-in-progress" },
    "danger":  { "value": "#DC2626", "tailwind": "red-600",    "cssVar": "--color-overdue" },
    "success": { "value": "#16A34A", "tailwind": "green-600",  "cssVar": "--color-accent-done" },
    "warning": { "value": "#CA8A04", "tailwind": "yellow-600", "cssVar": "--color-accent-todo" }
  },

  "background": {
    "board":       { "value": "#F1F2F4", "cssVar": "--color-board-bg",    "note": "board canvas — darker than columns for contrast" },
    "header":      { "value": "#FFFFFF", "cssVar": "--color-header-bg" },
    "card":        { "value": "#FFFFFF", "cssVar": "--color-card-bg" },
    "cardOverdue": { "value": "#FEE2E2", "cssVar": "--color-overdue-bg",  "tailwind": "red-100" }
  },

  "column": {
    "backlog":    { "bg": "#F5F3FF", "accent": "#7C3AED", "bgTailwind": "violet-50",  "accentTailwind": "violet-600", "bgVar": "--color-col-backlog",     "accentVar": "--color-accent-backlog" },
    "todo":       { "bg": "#FEFCE8", "accent": "#CA8A04", "bgTailwind": "yellow-50",  "accentTailwind": "yellow-600", "bgVar": "--color-col-todo",        "accentVar": "--color-accent-todo" },
    "inProgress": { "bg": "#EFF6FF", "accent": "#2563EB", "bgTailwind": "blue-50",    "accentTailwind": "blue-600",   "bgVar": "--color-col-in-progress", "accentVar": "--color-accent-in-progress" },
    "done":       { "bg": "#F0FDF4", "accent": "#16A34A", "bgTailwind": "green-50",   "accentTailwind": "green-600",  "bgVar": "--color-col-done",        "accentVar": "--color-accent-done" }
  },

  "text": {
    "primary":   { "value": "#111827", "tailwind": "gray-900", "cssVar": "--color-text-primary" },
    "secondary": { "value": "#4B5563", "tailwind": "gray-600", "cssVar": "--color-text-secondary" },
    "muted":     { "value": "#9CA3AF", "tailwind": "gray-400", "cssVar": "--color-text-muted" }
  },

  "border": {
    "default":   { "value": "#E2E8F0", "tailwind": "slate-200", "cssVar": "--color-border" },
    "hover":     { "value": "#CBD5E1", "tailwind": "slate-300",  "cssVar": "--color-border-hover" },
    "divider":   { "value": "#D1D5DB", "tailwind": "gray-300",   "cssVar": "--color-divider" },
    "focusRing": { "value": "#2563EB", "tailwind": "blue-600",   "cssVar": "--color-focus-ring" }
  },

  "priority": {
    "high":   { "text": "#DC2626", "bg": "#FEE2E2", "textTailwind": "red-600",  "bgTailwind": "red-100",    "textVar": "--color-priority-high" },
    "medium": { "text": "#2563EB", "bg": "#DBEAFE", "textTailwind": "blue-600", "bgTailwind": "blue-100",   "textVar": "--color-priority-medium" },
    "low":    { "text": "#6B7280", "bg": "#F1F5F9", "textTailwind": "gray-500", "bgTailwind": "slate-100",  "textVar": "--color-priority-low" }
  }
}
